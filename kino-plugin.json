{
  "id": "gnu-gnula",
  "name": "Gnu",
  "version": "0.1.20",
  "apiVersion": 6,
  "entry": "plugin.js",
  "description": "Películas, series y anime de GNULA HD",
  "author": "jlislas",
  "homepage": "https://github.com/jlislas/GNU",
  "hosts": [
    "gnulahd.nu",
    "*.gnulahd.nu",
    "image.tmdb.org",
    "i0.wp.com",
    "i1.wp.com",
    "i2.wp.com",
    "i3.wp.com",
    "vidara.to",
    "voe.sx"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve"
  ],
  "color": "#C1440E",
  "icon": "icon.png",
  "browser": true,
  "streamHosts": "any",
  "section": {
    "label": "Gnu",
    "labelEn": "Gnu"
  },
  "settings": [
    {
      "key": "contentType",
      "label": "Tipo de contenido",
      "labelEn": "Content type",
      "type": "select",
      "default": "all",
      "options": [
        { "value": "all", "label": "Todo", "labelEn": "All" },
        { "value": "movie", "label": "Películas", "labelEn": "Movies" },
        { "value": "series", "label": "Series", "labelEn": "Series" },
        { "value": "anime", "label": "Anime", "labelEn": "Anime" }
      ]
    },
    {
      "key": "genreFilter",
      "label": "Género",
      "labelEn": "Genre",
      "type": "select",
      "default": "all",
      "options": [
        { "value": "all", "label": "Todos", "labelEn": "All" },
        { "value": "accion", "label": "Acción", "labelEn": "Action" },
        { "value": "animacion", "label": "Animación", "labelEn": "Animation" },
        { "value": "aventura", "label": "Aventura", "labelEn": "Adventure" },
        { "value": "comedia", "label": "Comedia", "labelEn": "Comedy" },
        { "value": "crimen", "label": "Crimen", "labelEn": "Crime" },
        { "value": "ciencia-ficcion", "label": "Ciencia ficción", "labelEn": "Science fiction" },
        { "value": "drama", "label": "Drama", "labelEn": "Drama" },
        { "value": "fantasia", "label": "Fantasía", "labelEn": "Fantasy" },
        { "value": "misterio", "label": "Misterio", "labelEn": "Mystery" },
        { "value": "romance", "label": "Romance", "labelEn": "Romance" },
        { "value": "terror", "label": "Terror", "labelEn": "Horror" }
      ]
    },
    {
      "key": "yearFrom",
      "label": "Año desde",
      "labelEn": "From year",
      "type": "select",
      "default": "all",
      "options": [
        { "value": "all", "label": "Cualquier año", "labelEn": "Any year" },
        { "value": "2026", "label": "2026" },
        { "value": "2025", "label": "2025" },
        { "value": "2024", "label": "2024" },
        { "value": "2023", "label": "2023" },
        { "value": "2022", "label": "2022" },
        { "value": "2021", "label": "2021" },
        { "value": "2020", "label": "2020" },
        { "value": "2010", "label": "2010" },
        { "value": "2000", "label": "2000" }
      ]
    },
    {
      "key": "yearTo",
      "label": "Año hasta",
      "labelEn": "To year",
      "type": "select",
      "default": "all",
      "options": [
        { "value": "all", "label": "Cualquier año", "labelEn": "Any year" },
        { "value": "2026", "label": "2026" },
        { "value": "2025", "label": "2025" },
        { "value": "2024", "label": "2024" },
        { "value": "2023", "label": "2023" },
        { "value": "2022", "label": "2022" },
        { "value": "2021", "label": "2021" },
        { "value": "2020", "label": "2020" },
        { "value": "2010", "label": "2010" },
        { "value": "2000", "label": "2000" }
      ]
    }
  ]
}
